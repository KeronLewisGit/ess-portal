# ==============================================================================
# ESS Portal - environment configuration
# ==============================================================================
# Copy to .env and adjust. Values below default to LOCAL DEVELOPMENT with the
# provided docker-compose stack (nginx :8080, MySQL 8, Mailpit).
#
# A "PRODUCTION:" comment above a key states what must change on a live server.
# The production-critical keys are: APP_ENV, APP_DEBUG, APP_URL, APP_KEY,
# DB_*, SESSION_SECURE_COOKIE, MAIL_*, and the COMPANY_* block.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="ESS Portal"

# PRODUCTION: set to "production".
APP_ENV=local

# Generate with: php artisan key:generate. Never commit a real key.
# PRODUCTION: must be set (deploy checklist item); rotating it invalidates
# encrypted data (national IDs, salaries) - treat it as a secret.
APP_KEY=

# PRODUCTION: MUST be false. Debug pages leak configuration and code paths.
APP_DEBUG=true

# PRODUCTION: the real HTTPS URL, e.g. https://ess.example.com
APP_URL=http://localhost:8080

# All dates/times are stored and displayed in this timezone.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# PRODUCTION: use "error" or "warning".
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database (MySQL 8 / MariaDB 10.6+)
# ------------------------------------------------------------------------------
# Local: these match the docker-compose MySQL service (host "mysql" inside the
# containers; use 127.0.0.1:33060 from host tools).
# PRODUCTION: your host's MySQL credentials; a dedicated user with least
# privilege on a dedicated database.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ess_portal
DB_USERNAME=ess
DB_PASSWORD=secret

# ------------------------------------------------------------------------------
# Session / cookies
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# PRODUCTION: MUST be true (requires HTTPS). Cookies are then never sent over
# plain HTTP.
SESSION_SECURE_COOKIE=false

# Lax keeps the session on normal top-level navigation while blocking
# CSRF-prone cross-site POSTs.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# Default filesystem disk for non-sensitive files. Sensitive documents always
# use the dedicated "private" disk (config/filesystems.php) regardless of this.
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Queues
# ------------------------------------------------------------------------------
# "database" is the supported production driver. Run either:
#   - a persistent worker:  php artisan queue:work
#   - or a cron fallback (shared hosting, every minute):
#       * * * * * php artisan queue:work --stop-when-empty --max-time=55
# Set to "sync" to run jobs inline (everything still works, just synchronously
# and slower for the user). Any other value fails the /up health check.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------------
# Local: Mailpit from docker-compose. Web UI at http://localhost:8025.
# PRODUCTION: your real SMTP relay (e.g. Microsoft 365, Mailgun, cPanel mail)
# with TLS: MAIL_SCHEME=smtps, or port 587 + STARTTLS depending on provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

# PRODUCTION: a real mailbox on your domain, e.g. hr@yourcompany.com
MAIL_FROM_ADDRESS="hr@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# AWS (unused unless you opt into S3 storage)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# ESS Portal application settings
# ==============================================================================

# Seed defaults for the editable settings table (company identity used on
# screens and issued letters). After first seeding, edit these in the UI as
# super_admin - re-seeding never overwrites UI-edited values.
# PRODUCTION: set to your real company details before first deploy.
COMPANY_NAME="Acme Manufacturing Ltd"
COMPANY_ADDRESS="1 Industrial Park Way, Springfield"
HR_CONTACT_EMAIL="hr@example.com"

# ISO 4217 currency code used for salaries on letters.
SALARY_CURRENCY=USD

# Lifetime (minutes) of signed document download URLs (letters, payslips).
SIGNED_URL_EXPIRY_MINUTES=15

# Rate limits (enforced from the letter/payslip phases onwards).
RATE_LIMIT_PAYSLIPS_PER_HOUR=20
RATE_LIMIT_LETTER_REQUESTS_PER_DAY=10
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Optional TOTP 2FA for hr_admin / super_admin accounts (later phase).
TWO_FACTOR_ENABLED=false
